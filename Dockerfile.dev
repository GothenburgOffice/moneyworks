# Develop on the oldest supported Node line so newer-only APIs fail locally.
FROM node:22.23.4-trixie-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global npm@12.2.1
WORKDIR /workspace/web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

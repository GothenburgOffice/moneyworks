{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "unrs-resolver@1.11.1": true,
    "prisma@7.10.1": true,
    "@swc/core@1.16.20": true,
    "@prisma/engines@7.10.1": true
  }
}

{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path .gitignore --ignore-path ../.prettierignore ..",
    "format:check": "prettier --check --ignore-path ../.gitignore --ignore-path .gitignore --ignore-path ../.prettierignore ..",
    "test:line-endings": "node --test tests/line-endings.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:accounts": "playwright test --config playwright.accounts.config.ts",
    "test:ui": "node --test tests/site-ui.test.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs tests/features.test.mjs tests/workspace.test.mjs",
    "test:fire": "node --test tests/fire.test.mjs",
    "auth:cleanup": "node scripts/cleanup-auth.mjs",
    "test:auth-config": "node --test tests/auth-config.test.mjs tests/secrets.test.mjs tests/account-lifecycle.test.mjs",
    "test:accounts": "node tests/accounts.integration.mjs",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@swc/core@1.16.20": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}

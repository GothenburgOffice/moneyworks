{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:line-endings": "node --test tests/line-endings.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs tests/database-status.test.mjs",
    "test:db-status": "node --test tests/database-status.test.mjs",
    "test:ui": "node --test tests/site-ui.test.mjs",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@swc/core@1.16.20": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}

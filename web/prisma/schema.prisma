// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A user owns future saved work; credentials and future OAuth identities are
// separate accounts. Never use an email address as the business-data foreign key.
model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  // Admins see /admin. Set in the database, or once from ADMIN_EMAIL (lib/admin.ts).
  isAdmin       Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Set by an admin at /admin/users. A locked account cannot sign in; one in the
  // trash cannot either, and is deleted with all its data 30 days after deletedAt.
  lockedAt      DateTime?
  deletedAt     DateTime?
  // Set when a session is created (lib/auth.ts), shown at /admin/users.
  lastSignInAt  DateTime?
  sessions      Session[]
  accounts      Account[]
  scenarios     Scenario[]

  @@index([deletedAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Saved work from any tool. toolId matches features/tools/catalog.ts, and the
// tool's own validator checks data against schemaVersion before every write.
model Scenario {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId        String
  name          String
  schemaVersion Int
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, toolId])
}

// Site-wide settings edited at /admin. Secrets such as the SMTP password are
// stored encrypted with SETTINGS_ENCRYPTION_KEY (lib/secrets.ts).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

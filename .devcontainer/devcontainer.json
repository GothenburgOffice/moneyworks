{
  "name": "MoneyWorks",
  "dockerComposeFile": ["../compose.yaml", "../compose.dev.yaml", "compose.yaml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": ["db", "migrate", "app"],
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "Prisma.prisma"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "prettier.prettierPath": "/workspace/web/node_modules/prettier",
        "[prisma]": {
          "editor.defaultFormatter": "Prisma.prisma"
        },
        "typescript.tsdk": "/workspace/web/node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "eslint.workingDirectories": ["web"]
      }
    }
  }
}

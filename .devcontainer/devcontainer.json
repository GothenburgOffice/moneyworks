{
    "name": "Moneyworks",
    "dockerComposeFile": [
        "../docker-compose.dev.yml",
        "docker-compose.yml"
    ],
    "service": "web",
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    "forwardPorts": [3000],
    "postCreateCommand": "cd /workspace/web && npm ci && npm run db:setup",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "dbaeumer.vscode-eslint",
                "Prisma.prisma"
            ],
            "settings": {
                "typescript.tsdk": "/workspace/web/node_modules/typescript/lib",
                "typescript.enablePromptUseWorkspaceTsdk": true,
                "eslint.workingDirectories": [
                    "web"
                ]
            }
        }
    }
}

# Optional. Local Docker runs work without a .env file: docker-compose.dev.yml
# has development defaults. To override something, copy this file to .env
# (gitignored) and uncomment only the lines you change.

# Host ports; inside Docker the app uses 3000 and PostgreSQL 5432.
# MONEYWORKS_WEB_PORT=3410
# MONEYWORKS_DB_PORT=5410

# Database. PostgreSQL reads these only when it first creates its volume;
# later changes do not alter an existing user's password.
# DATABASE_URL is built from the three values below unless you set it. Set it
# yourself only if the password has characters that need URL-encoding.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=moneyworks
# DATABASE_URL=postgresql://postgres:password@db:5432/moneyworks

# Accounts stay disabled until AUTH_SECRET, mail and privacy details are set;
# the hub and FIRE calculator work without them. See AUTH.md.
# HTTP is accepted only for loopback development. Hosted accounts require HTTPS.
# AUTH_BASE_URL defaults to http://localhost:<MONEYWORKS_WEB_PORT>.
# AUTH_BASE_URL=http://localhost:3410
# AUTH_SECRET=at-least-32-random-characters-you-keep-private
# AUTH_PUBLIC_SIGNUP=true
# These public privacy details are required before registration is enabled.
# PRIVACY_CONTROLLER_NAME=
# PRIVACY_CONTACT_EMAIL=
# Mail uses SMTP, not an external mail-service SDK. External SMTP requires TLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# Test-only: plaintext SMTP is accepted only for a loopback capture server.
# SMTP_ALLOW_LOCAL_PLAINTEXT=false
# Leave empty for conservative shared rate limiting. Set ONLY when your reverse
# proxy overwrites this header and the app origin cannot be accessed directly.
# AUTH_TRUSTED_IP_HEADER=

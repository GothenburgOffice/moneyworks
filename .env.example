# Copy to .env before starting any stack: cp .env.example .env
# (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Only POSTGRES_PASSWORD is required. Use a long, random URL-safe password
# (letters, digits, - and _): it is also placed in the database URL.
# PostgreSQL reads it only when it first creates its volume.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3410
APP_ORIGIN=http://localhost:3410
# Optional extra exact origins, comma-separated (other domains, http://127.0.0.1).
# Blank means none in production stacks and http://127.0.0.1:<APP_PORT> in development.
# A malformed entry disables accounts with a 503 that names this setting.
APP_ORIGIN_ALIASES=
# Optional for compose.images.yaml: pin a published sha-... tag.
# MONEYWORKS_IMAGE=ghcr.io/gothenburgoffice/moneyworks:latest

# Accounts (see AUTH.md). Everything below is optional and off by default:
# accounts stay disabled until AUTH_SECRET, SMTP and the privacy details are set.
# HTTP is accepted only for loopback development. Hosted accounts require HTTPS.
# Blank ALLOW_REGISTRATION means on in development and off in production stacks.
ALLOW_REGISTRATION=
# At least 32 random characters, kept private.
AUTH_SECRET=
# These public privacy details are required before registration is enabled.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
# Mail uses SMTP, not an external mail-service SDK. External SMTP requires TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Leave empty for conservative shared rate limiting. Set ONLY when your reverse
# proxy overwrites this header and the app origin cannot be accessed directly.
AUTH_TRUSTED_IP_HEADER=

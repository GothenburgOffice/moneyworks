# Copy to .env before starting any stack: cp .env.example .env
# (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Only POSTGRES_PASSWORD is required. Use a long, random URL-safe password
# (letters, digits, - and _): it is also placed in the database URL.
# PostgreSQL reads it only when it first creates its volume.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3410
APP_ORIGIN=http://localhost:3410
# Optional extra exact origins, comma-separated (other domains, http://127.0.0.1).
# Blank means none. Development uses DEV_APP_ORIGIN_ALIASES instead (see below).
# A malformed entry disables accounts with a 503 that names this setting.
APP_ORIGIN_ALIASES=http://127.0.0.1:3410
# Optional home domain per language, for search engines. Every domain still serves
# every language; public pages then send canonical and hreflang links pointing at
# each language's own domain, and each domain's /sitemap.xml lists its languages'
# pages. Language links stay on the current domain. List every language, origin
# only (no path), e.g.
# LOCALE_ORIGINS=en=https://moneyworks.example,sv=https://pengarjobbar.example
# Blank or invalid sends no such links. The same origin may serve both languages.
# To use accounts on these domains, list them in APP_ORIGIN/APP_ORIGIN_ALIASES too.
LOCALE_ORIGINS=
# Optional for compose.images.yaml: pin a published sha-... tag.
# MONEYWORKS_IMAGE=ghcr.io/gothenburgoffice/moneyworks:latest

# Accounts (see AUTH.md). Everything below is optional and off by default:
# accounts stay disabled until AUTH_SECRET is set here. SMTP, the privacy
# controller/contact, the optional Google sign-in client and the public
# registration switch are never set here: they are SiteSetting rows edited
# at /admin (stored in the database), reachable once AUTH_SECRET is set and
# you sign in with ADMIN_EMAIL/ADMIN_PASSWORD below. The devcontainer always
# allows registration and seeds its own fake privacy details; no production
# stack does either.
# HTTP is accepted only for loopback development. Hosted accounts require HTTPS.
# At least 32 random characters, kept private.
AUTH_SECRET=
# Encrypts secrets saved at /admin, such as the SMTP password. 32 random bytes,
# base64: openssl rand -base64 32. Changing it makes stored secrets unreadable.
SETTINGS_ENCRYPTION_KEY=
# First admin for /admin, created when these are used to sign in on the account
# page while no admin exists (a verified account with this email is promoted,
# password unchanged).
# The password needs at least 15 characters. Ignored once an admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Leave empty for conservative shared rate limiting. Set ONLY when your reverse
# proxy overwrites this header and the app origin cannot be accessed directly.
AUTH_TRUSTED_IP_HEADER=

# Development only (compose.dev.yaml and the devcontainer). Dev ignores the
# production APP_ORIGIN*, AUTH_SECRET and SETTINGS_ENCRYPTION_KEY above and reads
# these instead. Mail and privacy live in the database (edit them at /admin). A
# dev stack with the same project name as a production stack shares its database
# and settings, so give one of them its own COMPOSE_PROJECT_NAME. Origins default
# to http://localhost:<APP_PORT> and http://127.0.0.1:<APP_PORT>. The devcontainer
# always allows registration.
DEV_APP_ORIGIN=
DEV_APP_ORIGIN_ALIASES=
DEV_LOCALE_ORIGINS=
DEV_AUTH_SECRET=
DEV_SETTINGS_ENCRYPTION_KEY=
DEV_SMTP_ALLOW_LOCAL_PLAINTEXT=
# Dev server file watching polls by default, because file events don't reach the
# container from a Windows drive. Set false when the checkout is on a Linux
# filesystem (a WSL2 clone, Linux or macOS) to save CPU.
WATCHPACK_POLLING=

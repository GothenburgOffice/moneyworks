# Copy this file to .env and maintain .env manually; it is gitignored.
# These fixed values are for development. Choose your own password before hosting.
# Keep DATABASE_URL credentials in sync with POSTGRES_USER / POSTGRES_PASSWORD.
# URL-encode special characters in the URL password (not in POSTGRES_PASSWORD).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=moneyworks
DATABASE_URL=postgresql://postgres:password@db:5432/moneyworks
# Changing these after PostgreSQL has initialized does not change an existing
# database user's password. Alter that password in PostgreSQL as well.

# Account setup. Keep manually maintained values private; no credential generator.
# HTTP is accepted only for loopback development. Hosted accounts require HTTPS.
AUTH_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-owner-maintained-secret
AUTH_PUBLIC_SIGNUP=true
# These public privacy details are required before registration is enabled.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
# Mail uses SMTP, not an external mail-service SDK. External SMTP requires TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Test-only: plaintext SMTP is accepted only for a loopback capture server.
SMTP_ALLOW_LOCAL_PLAINTEXT=false
# Leave empty for conservative shared rate limiting. Set ONLY when your reverse
# proxy overwrites this header and the app origin cannot be accessed directly.
AUTH_TRUSTED_IP_HEADER=
